APP_NAME=Country Risk Statistical Model Lab
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_AUTH_REQUIRED=false
AUTH_MODE=api_key
API_KEY=change-me-for-production
JWT_HS256_SECRET=change-me-only-for-gateway-signed-jwt-development
JWT_JWKS_URL=https://identity.example-bank.internal/.well-known/jwks.json
JWT_JWKS_PATH=
JWT_ISSUER=https://identity.example-bank.internal
JWT_AUDIENCE=country-risk-model-lab
AUDIT_LOG_PATH=backend/app/data_registry/audit/audit_events.jsonl
AUDIT_SINKS=local
AUDIT_HTTP_ENDPOINT=
AUDIT_HTTP_TOKEN=
AUDIT_HTTP_FAIL_CLOSED=false
MODEL_APPROVALS_PATH=backend/app/data_registry/model_approvals.json
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RBAC_ENFORCED=false
DATASET_REGISTRY_BACKEND=json
DATASET_REGISTRY_SQLITE_PATH=backend/app/data_registry/registry.sqlite3
